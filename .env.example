# Cadena de conexión PostgreSQL (Neon desde el Marketplace de Vercel la crea sola como DATABASE_URL).
# Si se deja vacía, en desarrollo local se usa una base PostgreSQL embebida (PGlite) en ./.siif-local
DATABASE_URL=

# Clave de un solo uso para crear el primer administrador en /instalacion.
# Elige una frase larga, guárdala y bórrala de Vercel después de crear el administrador.
SIIF_CLAVE_INSTALACION=

# Duración de la sesión (minutos de inactividad antes de pedir contraseña otra vez). Predeterminado: 240.
SIIF_SESION_INACTIVIDAD_MIN=240
# Duración máxima absoluta de una sesión en horas. Predeterminado: 14.
SIIF_SESION_MAX_HORAS=14
